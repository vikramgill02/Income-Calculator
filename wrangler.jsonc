{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "dashboard",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Every request goes through worker.js first so the password check
    // also covers paystubs.json, cards.json and the logos.
    "run_worker_first": true
  }
}
